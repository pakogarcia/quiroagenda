rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Application: QuiroAgenda
// Platform: Next.js on Firebase App Hosting
//
// 1. Collection: gabinete_data
//    Document ID: main
//    Description: Central clinic operational data (appointments, clients, services, etc.)
//    Fields:
//      - appointments: list of maps (optional, max 20000 items)
//      - clients: list of maps (optional, max 10000 items)
//      - services: list of maps (optional, max 200 items)
//      - blockedDays: list of string ISO dates (optional, max 1000 items)
//      - profile: map of business configuration (optional, max 30 keys)
//      - voucherSales: list of maps (optional, max 10000 items)
//      - expenses: list of maps (optional, max 10000 items)
//      - updatedAt: string ISO timestamp (optional, max 50 chars)
//
// 2. Collection: gabinete_data
//    Document ID: client_pins
//    Description: 64-character hexadecimal HMAC-SHA-256 hashes of client 4-digit PINs.
//    Fields:
//      - [clientId]: string (64-character hexadecimal SHA-256 hash)
//    Access: Single-document get permitted for server-side verification in /api/client-portal/auth.
//            Collection listing (list) and document deletion (delete) are strictly prohibited.
//            Updates are strictly restricted to 1 atomic PIN addition (with SHA-256 validation)
//            or 1 PIN deletion (reset). Existing PINs cannot be overwritten by anonymous clients.
//
// 3. Collection: gabinete_data
//    Document ID: auth_security
//    Description: PIN authentication attempt logs, rate limiting, and temporary lockouts.
//    Fields:
//      - failedAttempts: map of phone numbers to attempt metadata (max 10000 keys)
//      - updatedAt: string ISO timestamp (optional, max 50 chars)
//    Access: Single-document get permitted for server-side rate limit enforcement.
//            Collection listing and document deletion are strictly prohibited.
//            Creation and updates are strictly validated via isValidAuthSecurity.
//
// 4. Collection: settings
//    Document ID: security
//    Description: Master clinic administrator access hash.
//    Fields:
//      - passwordHash: string (required, 64-character hexadecimal SHA-256 hash)
//      - updatedAt: string ISO timestamp (optional, max 50 chars)
//    Access: Publicly readable by the clinic front-end for client-side password verification.
//            Creation permitted only during initial setup (when document does not exist).
//            Updates prohibited for unauthenticated users to prevent account takeover.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasOnlyAllowedFields(data, allowedFields) {
      return data.keys().hasOnly(allowedFields);
    }

    function isValidSha256(val) {
      return val is string &&
             val.size() == 64 &&
             val.matches('^[a-fA-F0-9]{64}$');
    }

    function isValidOptionalIsoDate(field, data) {
      return !(field in data) || (data[field] is string && data[field].size() <= 50);
    }

    function isValidOptionalList(field, data, maxSize) {
      return !(field in data) || (data[field] is list && data[field].size() <= maxSize);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validates administrator security settings document (settings/security)
    function isValidSecuritySettings(data) {
      return hasOnlyAllowedFields(data, ['passwordHash', 'updatedAt']) &&
             ('passwordHash' in data) &&
             isValidSha256(data.passwordHash) &&
             isValidOptionalIsoDate('updatedAt', data);
    }

    // Validates central business data document (gabinete_data/main)
    function isValidMainData(data) {
      return hasOnlyAllowedFields(data, [
        'appointments',
        'clients',
        'services',
        'blockedDays',
        'profile',
        'voucherSales',
        'expenses',
        'updatedAt'
      ]) &&
      isValidOptionalList('appointments', data, 20000) &&
      isValidOptionalList('clients', data, 10000) &&
      isValidOptionalList('services', data, 200) &&
      isValidOptionalList('blockedDays', data, 1000) &&
      isValidOptionalList('voucherSales', data, 10000) &&
      isValidOptionalList('expenses', data, 10000) &&
      isValidOptionalIsoDate('updatedAt', data) &&
      (!('profile' in data) || (data.profile is map && data.profile.keys().size() <= 30));
    }

    // Validates client PIN storage document on initial creation
    function isValidPinsCreate(data) {
      return data is map &&
             data.keys().size() <= 10000 &&
             (data.keys().size() != 1 || isValidSha256(data[data.keys()[0]]));
    }

    // Validates client PIN storage document on updates:
    // 1. Ensures map size remains within bounded limits (<= 10000 entries)
    // 2. Overwriting existing PINs is strictly prohibited (changedKeys().size() == 0) to prevent account takeover
    // 3. Permits atomic single-PIN addition (new registration) or deletion (admin reset)
    function isValidPinsUpdate(reqData, resData) {
      return reqData is map &&
             reqData.keys().size() <= 10000 &&
             reqData.diff(resData).changedKeys().size() == 0 &&
             reqData.diff(resData).affectedKeys().size() <= 1;
    }

    // Validates auth_security rate-limiting and lockout document
    function isValidAuthSecurity(data) {
      return hasOnlyAllowedFields(data, ['failedAttempts', 'updatedAt']) &&
             (!('failedAttempts' in data) || (data.failedAttempts is map && data.failedAttempts.keys().size() <= 10000)) &&
             isValidOptionalIsoDate('updatedAt', data);
    }

    // ===============================================================
    // Collection: settings
    // ===============================================================

    // Master password security settings document
    match /settings/security {
      // Allow get so the password gate can retrieve the hash for local validation
      allow get: if true;
      allow list: if false;

      // Allow initial creation ONLY if the document does not already exist
      allow create: if resource == null && isValidSecuritySettings(request.resource.data);

      // Prevent unauthorized overwrites once configured; updates require authentication
      allow update: if isAuthenticated() && isValidSecuritySettings(request.resource.data);

      // Disallow deletion of the master security settings
      allow delete: if false;
    }

    // Default deny for any other document in settings
    match /settings/{otherDoc} {
      allow read, write: if false;
    }

    // ===============================================================
    // Collection: gabinete_data
    // ===============================================================

    // Core operational document (appointments, clients, profile, services)
    match /gabinete_data/main {
      allow get: if true;
      allow list: if false;
      allow create: if isValidMainData(request.resource.data);
      allow update: if isValidMainData(request.resource.data);
      allow delete: if false; // Protect against accidental or malicious complete database wipe
    }

    // Client 4-digit PIN hashes - protected against mass downloads and unauthorized overwrites
    match /gabinete_data/client_pins {
      // Allow single document get so server API route /api/client-portal/auth can verify client credentials
      allow get: if true;
      // Prohibit collection listing / querying
      allow list: if false;
      // Allow initial creation with schema validation
      allow create: if isValidPinsCreate(request.resource.data);
      // Allow atomic updates: 1 pin added (with valid SHA-256) or 1 pin deleted (reset), never overwriting existing PINs
      allow update: if isValidPinsUpdate(request.resource.data, resource.data) || isAuthenticated();
      // Disallow document deletion
      allow delete: if false;
    }

    // Authentication rate-limiting and security lockout logs
    match /gabinete_data/auth_security {
      // Allow single document get for server API rate limit checks
      allow get: if true;
      // Prohibit collection listing
      allow list: if false;
      // Allow create and update validated by domain validator pattern
      allow create: if isValidAuthSecurity(request.resource.data);
      allow update: if isValidAuthSecurity(request.resource.data);
      // Disallow document deletion
      allow delete: if false;
    }

    // Default deny for any unexpected documents inside gabinete_data
    match /gabinete_data/{otherDoc} {
      allow read, write: if false;
    }

    // ===============================================================
    // Root Catch-All: Default Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
